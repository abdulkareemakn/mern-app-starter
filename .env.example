# Copy to .env at the repository root. Never commit .env.
NODE_ENV=development
PORT=3001
# Internal Express port used by Vite's development proxy.
API_PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/mern
# Public browser origin; use the same value for both URLs.
APP_URL=https://mern.localhost
BETTER_AUTH_URL=https://mern.localhost
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Optional: comma-separated IPs/CIDRs of your actual reverse proxy. Empty trusts none.
TRUST_PROXY=

# Full Compose stack: publish the app on this host port.
APP_PORT=3000
